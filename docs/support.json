[
  {"feature": "Headings (`# Title`)", "status": "supported", "cm": ["ATX headings"]},
  {"feature": "Underlined headings (`Title` over `---`)", "status": "not-yet", "cm": ["Setext headings"], "note": "The underline shows as a rule or as text."},
  {"feature": "Horizontal rules (`---`)", "status": "supported", "cm": ["Thematic breaks"]},
  {"feature": "Code blocks (fenced)", "status": "supported", "cm": ["Fenced code blocks"], "tests": [{"file": "test/syntax.test.ts", "title": "tilde fences and fence lengths"}], "note": "Language label, Copy button, optional highlighting."},
  {"feature": "Indented code blocks", "status": "not-yet", "cm": ["Indented code blocks"], "note": "Use fences."},
  {"feature": "Block quotes", "status": "supported", "cm": ["Block quotes"], "tests": [{"file": "test/syntax.test.ts", "title": "lazy blockquote continuation only follows paragraph text"}]},
  {"feature": "Lists", "status": "partial", "cm": ["Lists", "List items"], "tests": [{"file": "test/syntax.test.ts", "title": "list scanning"}], "note": "Nesting works. Blank lines between items are ignored."},
  {"feature": "Task lists", "status": "supported", "tests": [{"file": "test/syntax.test.ts", "title": "task lists"}], "note": "Checkboxes are read-only."},
  {"feature": "Tables", "status": "supported", "tests": [{"file": "test/syntax.test.ts", "title": "tables with alignment"}]},
  {"feature": "Bold and italic", "status": "supported", "cm": ["Emphasis and strong emphasis"], "note": "`snake_case_words` stay text."},
  {"feature": "Strikethrough (`~~text~~`)", "status": "supported", "tests": [{"file": "test/syntax.test.ts", "title": "single tilde is literal"}], "note": "Needs two tildes."},
  {"feature": "Inline code", "status": "supported", "cm": ["Code spans"]},
  {"feature": "Links", "status": "partial", "cm": ["Links"], "tests": [{"file": "test/xss.test.ts", "title": "blocked links keep the label as text"}], "note": "`[text](url)` only. A title is dropped, and unsafe URLs show as text."},
  {"feature": "Reference links (`[a][1]`)", "status": "not-yet", "cm": ["Link reference definitions"], "note": "Shown as text."},
  {"feature": "Autolinks (bare URLs, `www.`, emails)", "status": "partial", "cm": ["Autolinks"], "tests": [{"file": "test/syntax.test.ts", "title": "urls only autolink at a word boundary"}], "note": "Only http, https, and mailto. `www.` links use https."},
  {"feature": "Images", "status": "partial", "cm": ["Images"], "tests": [{"file": "test/images.test.ts", "title": "![alt](https-url) becomes an img with the alt text and a restrictive set of attributes"}], "note": "On by default and loaded without a click, so limit them with `images`. No titles."},
  {"feature": "Raw HTML", "status": "partial", "cm": ["HTML blocks", "Raw HTML"], "tests": [{"file": "test/html.test.ts", "title": "tags with attributes, unknown tags, and unbalanced tags stay text"}], "note": "Shown as text, except a few tags like `<kbd>` and `<sub>`."},
  {"feature": "Collapsible sections (`<details>`)", "status": "supported", "tests": [{"file": "test/details.test.ts", "title": "a well-formed block becomes details and summary, with or without blank lines inside"}], "note": "Each tag alone on its line."},
  {"feature": "HTML entities (`&amp;`)", "status": "not-yet", "cm": ["Entity and numeric character references"], "note": "Shown literally."},
  {"feature": "Backslash escapes", "status": "partial", "cm": ["Backslash escapes"], "note": "A few edge cases differ."},
  {"feature": "Line breaks", "status": "supported", "cm": ["Hard line breaks", "Soft line breaks"], "tests": [{"file": "test/syntax.test.ts", "title": "single trailing space before newline"}]},
  {"feature": "Tab indentation", "status": "not-yet", "cm": ["Tabs"]},
  {"feature": "Half-typed markers hidden while streaming", "status": "supported", "tests": [{"file": "test/half-open.test.ts", "title": "open fence shows code immediately"}, {"file": "browser/behavior.spec.ts", "title": "streaming never shows raw markers"}], "note": "A few exceptions, see Known limits."},
  {"feature": "Same output however the text is chunked", "status": "supported", "tests": [{"file": "test/chunk-fuzz.test.ts", "title": "two-part splits at every index"}]},
  {"feature": "Math (`$x$`)", "status": "not-yet", "note": "Planned as an opt-in hook you supply."},
  {"feature": "Footnotes", "status": "not-yet", "note": "Shown as text. Will be opt-in."},
  {"feature": "Alerts (`> [!NOTE]`)", "status": "not-yet", "note": "Shown as a plain block quote."},
  {"feature": "Citations (`[1]`) and emoji codes", "status": "not-yet", "note": "Shown literally. Will be opt-in."}
