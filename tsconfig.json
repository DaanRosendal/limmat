{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "limmat/react": ["./src/react.ts"],
      "limmat/vue": ["./src/vue.ts"],
      "limmat/svelte": ["./src/svelte.ts"]
    },
    "types": ["node"]
  },
  "include": ["src", "test", "browser", "*.ts"]
}
