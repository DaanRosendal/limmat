{
  "name": "limmat",
  "version": "0.4.0",
  "description": "Streaming markdown for LLM chat. Half-typed syntax renders cleanly, safe by default, works natively with any framework.",
  "type": "module",
  "license": "MIT",
  "author": "Daan Rosendal",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./highlight": {
      "types": "./dist/highlight.d.ts",
      "default": "./dist/highlight.js"
    },
    "./katex": {
      "types": "./dist/katex.d.ts",
      "default": "./dist/katex.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "default": "./dist/vue.js"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "default": "./dist/svelte.js"
    },
    "./solid": {
      "types": "./dist/solid.d.ts",
      "default": "./dist/solid.js"
    },
    "./style.css": {
      "types": "./dist/style.css.d.ts",
      "default": "./dist/style.css"
    },
    "./limmat.min.js": "./dist/limmat.min.js",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@speed-highlight/core": "^2.1.0",
    "react": ">=17",
    "solid-js": ">=1.6",
    "vue": "^3.2.0"
  },
  "peerDependenciesMeta": {
    "@speed-highlight/core": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "size": "node scripts/size.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run check:style && npm test && npm run build && npm run build:demo && npm run check:package && npm run check:support && npm run check:compare && npm run size && npm run test:browser",
    "test:browser:chromium": "playwright test --project=chromium",
    "check:package": "node scripts/check-package.mjs",
    "support": "node scripts/gen-support.mjs",
    "check:support": "node scripts/gen-support.mjs --check",
    "compare:table": "node scripts/gen-compare.mjs",
    "check:compare": "node scripts/gen-compare.mjs --check",
    "compare": "node benchmarks/compare/run.mjs",
    "check:style": "node scripts/check-style.mjs",
    "prepublishOnly": "npm run build && npm run check:package",
    "build:demo": "node scripts/build-demo.mjs",
    "record": "node scripts/record-demo.mjs",
    "demo:gifs": "gh release download media --repo DaanRosendal/limmat --pattern '*.gif' --dir demo/out --clobber",
    "deploy:demo": "npm run build && npm run build:demo && npm run demo:gifs && npm ci --ignore-scripts --prefix deploy && WRANGLER_SEND_METRICS=false deploy/node_modules/.bin/wrangler deploy",
    "demo": "npm run build && npm run build:demo && node scripts/serve-demo.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "^1.65.1",
    "@solidjs/web": "2.0.3",
    "@speed-highlight/core": "^2.1.0",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "^0.28.2",
    "happy-dom": "21.0.4",
    "jsdom": "^31.0.1",
    "katex": "0.19.1",
    "linkedom": "0.18.15",
    "mathjax": "4.1.3",
    "preact": "11.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "solid-js": "2.0.3",
    "solid-js-v1": "npm:solid-js@1.9.20",
    "svelte": "5.59.1",
    "temml": "0.14.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "vue": "3.5.46"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DaanRosendal/limmat.git"
  },
  "homepage": "https://github.com/DaanRosendal/limmat#readme",
  "bugs": {
    "url": "https://github.com/DaanRosendal/limmat/issues"
  },
  "keywords": [
    "llm",
    "markdown",
    "markdown-renderer",
    "streaming",
    "typescript",
    "xss",
    "ai",
    "chatbot",
    "framework-agnostic",
    "zero-dependencies"
  ]
}
