{
  "name": "limmat",
  "version": "0.1.0",
  "description": "Streaming markdown for LLM chat. Half-typed syntax renders cleanly, safe by default, works with any framework.",
  "type": "module",
  "license": "MIT",
  "author": "Daan Rosendal",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./highlight": {
      "types": "./dist/highlight.d.ts",
      "default": "./dist/highlight.js"
    },
    "./style.css": "./dist/style.css",
    "./limmat.min.js": "./dist/limmat.min.js",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@speed-highlight/core": "^2.1.0"
  },
  "peerDependenciesMeta": {
    "@speed-highlight/core": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "size": "node scripts/size.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run check:style && npm test && npm run build && npm run build:demo && npm run check:package && npm run check:support && npm run size && npm run test:browser",
    "test:browser:chromium": "playwright test --project=chromium",
    "check:package": "node scripts/check-package.mjs",
    "support": "node scripts/gen-support.mjs",
    "check:support": "node scripts/gen-support.mjs --check",
    "check:style": "node scripts/check-style.mjs",
    "prepublishOnly": "npm run build && npm run check:package",
    "build:demo": "node scripts/build-demo.mjs",
    "record": "node scripts/record-demo.mjs",
    "deploy:demo": "npm run build && npm run build:demo && npm ci --ignore-scripts --prefix deploy && WRANGLER_SEND_METRICS=false deploy/node_modules/.bin/wrangler deploy",
    "demo": "npm run build && npm run build:demo && node scripts/serve-demo.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "^1.65.1",
    "@speed-highlight/core": "^2.1.0",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DaanRosendal/limmat.git"
  },
  "homepage": "https://github.com/DaanRosendal/limmat#readme",
  "bugs": {
    "url": "https://github.com/DaanRosendal/limmat/issues"
  },
  "keywords": [
    "llm",
    "markdown",
    "markdown-renderer",
    "streaming",
    "typescript",
    "xss",
    "ai",
    "chatbot",
    "framework-agnostic",
    "zero-dependencies"
  ]
}
